# ===========================================
# Server SSL Certificate Configuration
# ===========================================
#
# HƯỚNG DẪN SỬ DỤNG:
# 1. Copy file này thành 'keystore.config'
# 2. Đổi các giá trị bên dưới
# 3. Chạy generate-cert.bat để tạo certificate
#
# ===========================================

# Keystore file name
KEYSTORE_FILE=server.keystore

# Keystore password (ĐỔI TRONG PRODUCTION!)
KEYSTORE_PASSWORD=pricetracker123

# Certificate alias
KEY_ALIAS=pricetracker

# Certificate validity (days)
VALIDITY_DAYS=365

# ===========================================
# Certificate Subject Information
# ===========================================

# Common Name (CN) - Hostname hoặc domain
# Development: localhost
# Production: your-domain.com hoặc server IP
CN=localhost

# Organizational Unit
OU=PriceTracker

# Organization Name
O=PriceTracker

# City/Locality
L=HCM

# State/Province
ST=HCM

# Country Code (2 letters)
C=VN

# ===========================================
# Subject Alternative Names (SAN)
# ===========================================
# Danh sách domains/IPs được certificate cover
# Cách sử dụng: dns:domain1,dns:domain2,ip:1.2.3.4

# Development
SAN=dns:localhost,ip:127.0.0.1

# Production (ví dụ)
# SAN=dns:pricetracker.company.com,dns:www.pricetracker.company.com,ip:192.168.1.100

# ===========================================
# Advanced Settings
# ===========================================

# Key algorithm (RSA, EC)
KEY_ALGORITHM=RSA

# Key size (2048, 3072, 4096)
KEY_SIZE=2048

# ===========================================
# PRODUCTION CHECKLIST:
# ===========================================
# [ ] Đổi KEYSTORE_PASSWORD thành password mạnh
# [ ] Đổi CN thành domain hoặc IP thật
# [ ] Cập nhật SAN với tất cả domains/IPs sử dụng
# [ ] Set VALIDITY_DAYS phù hợp (365, 730)
# [ ] Backup keystore file sau khi generate
# [ ] Không commit keystore vào Git
# ===========================================
