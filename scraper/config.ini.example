# ============================================================
# PRICE TRACKER - CẤU HÌNH SCRAPER TỰ ĐỘNG
# ============================================================
# File này là TEMPLATE - KHÔNG chứa thông tin nhạy cảm
# Hướng dẫn sử dụng:
#   1. Copy file này thành "config.ini"
#   2. Điền thông tin thật của bạn vào config.ini
#   3. Thêm config.ini vào .gitignore để bảo mật
# ============================================================

[DATABASE]
# Thông tin kết nối MySQL
host = localhost
port = 3306
database = price_insight
user = root
password = 
charset = utf8mb4

[XAMPP]
# Đường dẫn cài đặt XAMPP
xampp_path = C:\xampp
xampp_control = C:\xampp\xampp-control.exe
mysql_service_name = MySQL

[SCRAPER]
# Cấu hình scraping
delay_between_requests = 2
request_timeout = 10
max_retries = 3
retry_delay = 60

[EMAIL]
# Cấu hình gửi email thông báo
enabled = true
smtp_server = smtp-mail.outlook.com
smtp_port = 587
sender_email = your_email@ut.edu.vn
sender_password = your_password_here
sender_name = Price Tracker System

# Danh sách email nhận thông báo (cách nhau bởi dấu phẩy)
recipients = tranhtq0763@ut.edu.vn,trangntt2921@ut.edu.vn,khoanda5875@ut.edu.vn,khainq4248@ut.edu.vn,sanglv2108@ut.edu.vn

# Chủ đề email
subject_success = [Price Tracker] ✅ Cào dữ liệu thành công
subject_failed = [Price Tracker] ❌ Cào dữ liệu thất bại

[LOGGING]
# Cấu hình logging
log_dir = logs
log_level = INFO
log_format = %%(asctime)s - %%(levelname)s - %%(message)s
max_log_files = 30
