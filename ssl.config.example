# ============================================
# SSL/TLS Certificate Configuration
# ============================================
# 
# Copy this file to the actual config location and update the values
# 
# For Server:
#   - Copy to: server/certs/ssl.config
#   - Generate keystore using: generate-cert.bat
#
# For Client:
#   - Copy to: client/certs/ssl.config
#   - Generate truststore using: server/certs/export-cert-for-client.bat

# ============================================
# KEYSTORE CONFIGURATION (Server)
# ============================================

# Path to keystore file (relative to project root)
KEYSTORE_PATH=server/certs/server.keystore

# Keystore password
KEYSTORE_PASSWORD=pricetracker123

# Certificate alias
KEY_ALIAS=pricetracker

# Keystore type (JKS, PKCS12)
KEYSTORE_TYPE=JKS

# ============================================
# TRUSTSTORE CONFIGURATION (Client)
# ============================================

# Path to truststore file (relative to project root)
TRUSTSTORE_PATH=client/certs/truststore.jks

# Truststore password
TRUSTSTORE_PASSWORD=pricetracker123

# Truststore type (JKS, PKCS12)
TRUSTSTORE_TYPE=JKS

# ============================================
# SSL/TLS SETTINGS
# ============================================

# Enable/Disable SSL (true/false)
SSL_ENABLED=true

# Trust all certificates - DEVELOPMENT ONLY (true/false)
# WARNING: Set to false in production!
SSL_TRUST_ALL=false

# TLS Protocol (TLSv1.3, TLSv1.2)
TLS_PROTOCOL=TLSv1.3

# ============================================
# CERTIFICATE GENERATION SETTINGS
# ============================================

# Certificate validity in days
CERT_VALIDITY_DAYS=365

# Certificate Distinguished Name
CERT_DN_CN=localhost
CERT_DN_OU=PriceTracker
CERT_DN_O=PriceTracker
CERT_DN_L=HCM
CERT_DN_ST=HCM
CERT_DN_C=VN

# Subject Alternative Names (comma-separated)
CERT_SAN=DNS:localhost,IP:127.0.0.1

# Key algorithm and size
KEY_ALGORITHM=RSA
KEY_SIZE=2048

# ============================================
# PRODUCTION NOTES
# ============================================
#
# 1. Change all passwords before deploying to production
# 2. Use certificates from trusted CA (Let's Encrypt, DigiCert, etc.)
# 3. Set SSL_TRUST_ALL=false in production
# 4. Store passwords in environment variables or secret manager
# 5. Rotate certificates before expiration
# 6. Use proper DNS names instead of localhost
#
# ============================================
